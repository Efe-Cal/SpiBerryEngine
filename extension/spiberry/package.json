{
  "name": "spiberry",
  "displayName": "spiberry",
  "description": "",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spiberry.setDeviceCredentials",
        "title": "Spiberry: Set Device Credentials"
      },
      {
        "command":"spiberry.installSpiBerryEngine",
        "title": "Spiberry: Install SpiBerry Engine"
      },
      {
        "command": "spiberry.sendCodeToDevice",
        "title": "Spiberry: Send Code to Device"
      },
      {
        "command": "spiberry.installTypings",
        "title": "Spiberry: Install Typings for SPIKE Python v3"
      },
      {
        "command": "spiberry.insertRaspiUtilClasses",
        "title": "Spiberry: Insert Raspi Util Classes"
      },
      {
        "command": "spiberry.enableService",
        "title": "Spiberry: Enable Service"
      },
      {
        "command": "spiberry.disableService",
        "title": "Spiberry: Disable Service"
      },
      {
        "command": "spiberry.startService",
        "title": "Spiberry: Start Service"
      },
      {
        "command": "spiberry.stopService",
        "title": "Spiberry: Stop Service"
      },
      {
        "command": "spiberry.followServiceJournal",
        "title": "Spiberry: Follow Service Journal"
      },
      {
        "command": "spiberry.openSshConsole",
        "title": "Spiberry: Open SSH Console"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Spiberry Configuration",
      "properties": {
        "spiberry.autoSendOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically send code to the device when a file is saved."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "spiberrySidebar",
          "title": "SpiBerry",
          "icon": "resources/spiberry.svg"
        }
      ]
    },
    "views": {
      "spiberrySidebar": [
        {
          "id": "spiberry.controlPanel",
          "name": "Control Panel",
          "type": "webview"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "node-ssh": "^13.2.1"
  }
}
