{
  "name": "spiberry",
  "displayName": "spiberry",
  "description": "",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.110.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:spiberry.setDeviceCredentials",
    "onCommand:spiberry.installSpiBerryEngine",
    "onCommand:spiberry.sendCodeToDevice"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "spiberry.setDeviceCredentials",
        "title": "Spiberry: Set Device Credentials"
      },
      {
        "command":"spiberry.installSpiBerryEngine",
        "title": "Spiberry: Install SpiBerry Engine"
      },
      {
        "command": "spiberry.sendCodeToDevice",
        "title": "Spiberry: Send Code to Device"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "Spiberry Configuration",
      "properties": {
        "spiberry.autoSendOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically send code to the device when a file is saved."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/ssh2": "^1.15.5",
    "@types/vscode": "^1.110.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "node-ssh": "^13.2.1"
  }
}
